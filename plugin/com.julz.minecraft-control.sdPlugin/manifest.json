{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "Minecraft Control",
	"Version": "1.0.0.0",
	"Author": "Julz",
	"Actions": [
		{
			"Name": "Render distance",
			"UUID": "com.julz.minecraft-control.render-distance",
			"Icon": "imgs/actions/renderDistance",
			"Tooltip": "Raises or lowers the render distance; shows the current chunks.",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/renderDistance-key",
					"ShowTitle": false,
					"TitleAlignment": "top"
				}
			],
			"PropertyInspectorPath": "ui/step.html"
		},
		{
			"Name": "Simulation distance",
			"UUID": "com.julz.minecraft-control.simulation-distance",
			"Icon": "imgs/actions/simulationDistance",
